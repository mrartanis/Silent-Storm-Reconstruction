# Use a separately populated ARM64 Linux sysroot; no host packages are replaced.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(S2_ARM64_SYSROOT "" CACHE PATH "ARM64 Linux development/runtime sysroot")
set(S2_ARM64_GCC_TOOLCHAIN /usr CACHE PATH "Host root containing the ARM64 GCC cross toolchain")
if(NOT IS_DIRECTORY "${S2_ARM64_SYSROOT}/usr/include")
  message(FATAL_ERROR "Set S2_ARM64_SYSROOT to a populated ARM64 Linux sysroot")
endif()
set(CMAKE_C_COMPILER clang-18)
set(CMAKE_CXX_COMPILER clang++-18)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN "${S2_ARM64_GCC_TOOLCHAIN}")
set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN "${S2_ARM64_GCC_TOOLCHAIN}")
set(CMAKE_SYSROOT "${S2_ARM64_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES S2_ARM64_SYSROOT S2_ARM64_GCC_TOOLCHAIN)
