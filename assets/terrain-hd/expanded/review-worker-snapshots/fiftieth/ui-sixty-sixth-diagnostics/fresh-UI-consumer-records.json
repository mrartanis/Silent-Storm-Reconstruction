        {
          "file": "DBFormat/DataRPG.cpp",
          "first_line": 781,
          "last_line": 790,
          "source_excerpt": "781: void CRPGClass::Import()\n782: {\n783: \tImportSkills( skills.skills );\n784: \tNDatabase::ImportField( \"PerkTreeID\", &nPerkTreeID );\n785: \t////\n786: \tNDatabase::ImportField( \"ToolTip\", &pToolTip );\n787: \tNDatabase::ImportField( \"Icon\", &pIcon );\n788: \tNDatabase::ImportField( \"IconDisabled\", &pIconDisabled );\n789: \tNDatabase::ImportField( \"PerksPanel\", &pPerksPanel );\n790: }",
