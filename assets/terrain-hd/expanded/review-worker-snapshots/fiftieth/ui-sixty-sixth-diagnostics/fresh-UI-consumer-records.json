        {
          "file": "Main/iCharGen.cpp",
          "first_line": 553,
          "last_line": 570,
          "source_excerpt": "553: \n554: \t\t\tconst vector<CPtr<NDb::CRPGPers> > &classes = pSide->malePersesSet;\n555: \n556: \t\t\tclassIconsSet.resize( ARRAY_SIZE( sClassTable ) );\n557: \t\t\tfor ( int nTemp = 0; nTemp < ARRAY_SIZE( sClassTable ); nTemp++ )\n558: \t\t\t{\n559: \t\t\t\tCPtr<NDb::CRPGPers> pTempPers = classes[sClassTable[nTemp].eClass];\n560: \t\t\t\tCPtr<CComplexButton> pButton = new CComplexButton( sEvent.pLoader->GetControl( sClassTable[nTemp].pszID ), 0, 0, NDb::GetUITexture( 566 ), NDb::GetUITexture( 408 ) );\n561: \n562: \t\t\t\tif ( IsValid( pTempPers ) && IsValid( pTempPers->pClass ) )\n563: \t\t\t\t{\n564: \t\t\t\t\tpButton->Set( pTempPers->pClass->pIcon, pTempPers->pClass->pIconDisabled, CComplexButton::UNCHECKED );\n565: \t\t\t\t\t// The class description is DATA-DRIVEN by the control's own TooltipID (container 345:\n566: \t\t\t\t\t// medic/scout/sniper/soldier/engineer/grenadier carry TooltipID 11086-11091). Retail\n567: \t\t\t\t\t// (CCharGenUI::ProcessMessage @0x1b5da0) sets tooltips ONLY on the nationality icons\n568: \t\t\t\t\t// (national_0/1/2 have TooltipID=0 so they MUST be set in code); it does NOT touch the class\n569: \t\t\t\t\t// icons. The dev's GetToolTip()->SetText( pClass->pToolTip ) here wrote an empty/invalid\n570: \t\t\t\t\t// string over the good data-driven tooltip -> the class description stopped appearing.",
          "file_sha256": "3f3a94f34b6bf317b82796a3eb12fc858beb4d2c5e9aaa07ce056b90b65b60d8"
        }
      ],
